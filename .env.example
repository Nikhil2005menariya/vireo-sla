# Copy to .env (gitignored) and fill in to use `--enrich bedrock`.
# A Bedrock long-term API key (AWS "Bedrock API keys" feature):
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token
AWS_REGION=us-east-1
# Optional: override the model (any Bedrock Converse-capable model id)
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
